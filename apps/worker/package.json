{
  "name": "@tozalist/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tozalist/core": "workspace:^",
    "@tozalist/db": "workspace:^",
    "@tozalist/shared": "workspace:^",
    "bullmq": "^5.34.0",
    "csv-parse": "^7.0.2",
    "ioredis": "^5.4.1",
    "pino": "^10.3.1",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.12",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.38.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
