{
  "name": "@tozalist/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "create-key": "tsx src/cli/create-key.ts",
    "revoke-key": "tsx src/cli/revoke-key.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^9",
    "@fastify/cors": "^8",
    "@fastify/multipart": "^8.3.1",
    "@fastify/swagger": "^8",
    "@fastify/swagger-ui": "^2",
    "@tozalist/core": "workspace:^",
    "@tozalist/db": "workspace:^",
    "@tozalist/shared": "workspace:*",
    "bullmq": "^5.34.0",
    "csv-parse": "^7.0.2",
    "fastify": "^4.28.1",
    "fastify-plugin": "^6.0.0",
    "ioredis": "^5.4.1",
    "iron-session": "^8.0.4"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "^2.9.1",
    "@types/node": "^20.17.12",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.38.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
