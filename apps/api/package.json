{
  "name": "@tozalist/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "create-key": "tsx src/cli/create-key.ts",
    "revoke-key": "tsx src/cli/revoke-key.ts",
    "export-openapi": "tsx scripts/export-openapi.ts",
    "billing-grant": "tsx src/cli/billing-grant.ts",
    "billing-statement": "tsx src/cli/billing-statement.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/multipart": "10.1.1",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "@tozalist/core": "workspace:^",
    "@tozalist/db": "workspace:^",
    "@tozalist/shared": "workspace:*",
    "bullmq": "^5.34.0",
    "csv-parse": "^7.0.2",
    "fastify": "5.12.1",
    "fastify-plugin": "6.0.0",
    "ioredis": "^5.4.1",
    "iron-session": "^8.0.4",
    "yazl": "^3.3.1",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "^2.9.1",
    "@types/node": "^20.17.12",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "dotenv": "^17.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "yauzl": "^3.4.0"
  }
}
