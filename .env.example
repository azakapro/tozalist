# ---------------------------------------------------------------------------
# TozaList local development environment.
#
#   cp .env.example .env
#   docker compose up -d
#
# Every value below is a LOCAL PLACEHOLDER. Never commit a real credential,
# and never reuse these values outside a developer machine.
# ---------------------------------------------------------------------------

# --- PostgreSQL -----------------------------------------------------------
# Credentials used both by the compose "postgres" service and by the apps.
POSTGRES_USER=tozalist
POSTGRES_PASSWORD=local_dev_password
POSTGRES_DB=tozalist
DATABASE_URL=postgresql://tozalist:local_dev_password@localhost:5432/tozalist

# Dedicated database for integration tests. It is dropped and recreated by
# `pnpm db:test:prepare`, so it must never point at the development database.
# The tooling refuses to run if it is missing, equal to DATABASE_URL, or names
# a database that does not end in "_test".
DATABASE_URL_TEST=postgresql://tozalist:local_dev_password@localhost:5432/tozalist_test

# --- Redis ----------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Object storage (MinIO, S3-compatible) --------------------------------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=tozalist_local
S3_SECRET_KEY=local_dev_secret
S3_BUCKET=tozalist-local

# --- API ------------------------------------------------------------------
API_PORT=3001
# Session-cookie auth for the dashboard's /internal routes. At least 32
# characters; generate a fresh value per environment. Absent = routes disabled.
SESSION_SECRET=local_dev_session_secret_change_me_0000
DASHBOARD_ORIGIN=http://localhost:3002
WEB_ORIGIN=http://localhost:3000

# --- Internal Go engine ---------------------------------------------------
# Reachable only from inside the compose network. It is never published to
# the host and must never be exposed publicly. See docs/architecture.md.
#
# Production and in-network processes use the internal hostname below. For
# host-run local development, start the stack with the dev override
# (docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d)
# and set ENGINE_URL=http://127.0.0.1:8080 instead.
ENGINE_URL=http://engine:8080
# Port the engine listens on inside the network, and the total deadline for
# one /verify request (DNS and SMTP included).
ENGINE_PORT=8080
VERIFY_TIMEOUT_SECONDS=15

# --- SMTP probing ---------------------------------------------------------
# Disabled by default. When enabled, the worker probes mailboxes through the
# internal engine, throttled per MX host.
SMTP_ENABLED=false
SMTP_WORKER_CONCURRENCY=10
SMTP_HELO_DOMAIN=localhost
SMTP_PROBE_FROM=postmaster@localhost
# Isolated bucket for destructive storage tests; must differ from S3_BUCKET.
S3_BUCKET_TEST=tozalist-test
# Display-only bank-transfer instructions shown to invoice requesters.
# Never real account data in this file - set the real text in the deployed env.
BILLING_BANK_DETAILS="Bank transfer details are provided with your invoice."
