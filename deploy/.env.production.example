# Copy to a chmod-600 file outside version control. Empty required values make
# `docker compose config` fail closed until an operator supplies them.

DOMAIN=
ACME_EMAIL=

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
REDIS_PASSWORD=

# Product object storage (batch inputs/results and account exports).
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# A different bucket or isolated prefix/credential dedicated to database dumps.
# The endpoint must use HTTPS outside the explicit local verification override.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# Generate at least 32 random bytes for each value; never reuse them.
SESSION_SECRET=
METRICS_TOKEN=

# Synthetic preview safety lock. Production Compose also pins this to false.
SMTP_ENABLED=false
VERIFY_TIMEOUT_SECONDS=15
